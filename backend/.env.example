# Example backend/.env
# Copy this file to backend/.env and fill in real values (do NOT commit backend/.env)

# SQLAlchemy/Postgres connection string to your Supabase database
# Format: postgresql://<user>:<password>@<host>:5432/<database>
SUPABASE_DB_URL=postgres://user:password@db-host:5432/dbname

# Optional: override CORS allowed origins (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000

# OPTIONAL: if you want to bootstrap storage from Supabase on startup
#BOOTSTRAP_FROM_SUPABASE=false
