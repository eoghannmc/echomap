# Example frontend/.env.local
# Copy to frontend/.env.local (do NOT commit) and fill in real values.

# Public Supabase URL (no secret)
SUPABASE_URL=https://your-project.supabase.co

# Server-side Service Role key (secret): used by the Next.js API route to write to Supabase
# KEEP THIS SECRET — do NOT expose to the browser or commit. Put it in frontend/.env.local only.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Where backend FastAPI runs (optional; used by client code if necessary)
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_MAPTILER_API_KEY=X9gLDDRL5lBfq37uyQF6	
